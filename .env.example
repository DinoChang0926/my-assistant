# GitHub Copilot SDK Token
COPILOT_GITHUB_TOKEN=your_github_token_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Copilot Model (default: claude-3.5-sonnet)
COPILOT_MODEL=claude-3.5-sonnet

# Evolution Model (for coding & tool creation, e.g., claude-3.5-sonnet, gpt-4)
COPILOT_EVOLUTION_MODEL=claude-3.5-sonnet

# GitHub Repository for Agent Evolution (e.g., username/repo)
GITHUB_REPO_NAME=your_username/your_repo_name

# FastAPI Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Session Manager Configuration
SESSION_MAX_TURNS=10  # Trigger compression after N turns
SESSION_TIMEOUT_MINUTES=30

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Your Name <your_email@gmail.com>
